# Where the backend lives, as seen FROM THE BROWSER.
#
# Local development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:5100
#
# Deployed on Netlify: localhost means the VISITOR's machine, not yours, so
# every call fails. Point this at a publicly reachable backend — the dev tunnel
# works while VS Code is forwarding port 5100:
#
#   NEXT_PUBLIC_BACKEND_URL=https://7lrcjgtk-5100.inc1.devtunnels.ms
#
# Set it in Netlify under Site settings -> Environment variables, NOT here.
# NEXT_PUBLIC_ values are baked in at build time, so changing it needs a redeploy.
